{
  "$comment": "Paylasilan proje ayarlari — versiyonlanir. Makineye ozgu izinler ve yollar .claude/settings.local.json'a (gitignore'lu) yazilir.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/gate-guard.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/quality-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/routemap-sync.sh"
          }
        ]
      }
    ]
  }
}
