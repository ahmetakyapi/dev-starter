{
  "$comment": "Paylasilan proje ayarlari — versiyonlanir. Makineye ozgu izinler ve yollar .claude/settings.local.json'a (gitignore'lu) yazilir. Hook yollari $CLAUDE_PROJECT_DIR'a bagli: hook Claude'un o anki dizininde kosar, goreli yol bir cd sonrasi bulunamaz (exit 127 bloklamaz, commit taramasiz gecer).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/gate-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/quality-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/routemap-sync.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/hooks/session-brief.sh"
          }
        ]
      }
    ]
  }
}
