{
  "name": "@ahmetakyapi/theme",
  "version": "3.0.0",
  "description": "Kişisel proje tema tokenları — Tailwind v4 iki katmanlı rol token'ları (theme.css) ve JS aynası",
  "keywords": [
    "design-tokens",
    "tailwind",
    "tailwindcss-v4",
    "theme",
    "css-variables",
    "design-system"
  ],
  "author": "Ahmet Akyapı <ahmetakyapii@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ahmetakyapi/dev-starter/tree/main/packages/@ahmet/theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetakyapi/dev-starter.git",
    "directory": "packages/@ahmet/theme"
  },
  "bugs": {
    "url": "https://github.com/ahmetakyapi/dev-starter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./css": "./index.css",
    "./index.css": "./index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "index.css",
    "tokens.ts"
  ],
  "scripts": {
    "dev": "tsup --entry.index=tokens.ts --watch --format esm,cjs --dts",
    "build": "tsup --entry.index=tokens.ts --format esm,cjs --dts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
