{
  "name": "@ahmetakyapi/ui",
  "version": "2.1.0",
  "description": "Kişisel proje UI bileşen kütüphanesi — glass, chip, cursor, spotlight",
  "keywords": [
    "react",
    "ui",
    "components",
    "framer-motion",
    "glassmorphism",
    "tailwind",
    "design-system"
  ],
  "author": "Ahmet Akyapı <ahmetakyapii@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ahmetakyapi/dev-starter/tree/main/packages/@ahmet/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetakyapi/dev-starter.git",
    "directory": "packages/@ahmet/ui"
  },
  "bugs": {
    "url": "https://github.com/ahmetakyapi/dev-starter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev": "tsup src/index.ts --watch --format esm,cjs --dts",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "framer-motion": ">=11",
    "next-themes": ">=0.3",
    "tailwindcss": ">=3"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^18"
  },
  "dependencies": {
    "@ahmetakyapi/theme": "^2.1.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0"
  }
}
