{
  "name": "@ahmetakyapi/ui",
  "version": "3.0.0",
  "description": "Kişisel proje UI bileşen kütüphanesi — Surface, Button, Chip, imleç ve Motion yardımcıları",
  "keywords": [
    "react",
    "ui",
    "components",
    "motion",
    "tailwind",
    "design-system"
  ],
  "author": "Ahmet Akyapı <ahmetakyapii@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ahmetakyapi/dev-starter/tree/main/packages/@ahmet/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetakyapi/dev-starter.git",
    "directory": "packages/@ahmet/ui"
  },
  "bugs": {
    "url": "https://github.com/ahmetakyapi/dev-starter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "motion": ">=12",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/react": "^19"
  },
  "dependencies": {
    "@ahmetakyapi/theme": "^3.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
