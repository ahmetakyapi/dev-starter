{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/demo", "destination": "/demo-app/overview", "permanent": false },
    { "source": "/demo/:story", "destination": "/demo-app/:story", "permanent": false },
    { "source": "/pusula", "destination": "/demo-app/overview", "permanent": true },
    { "source": "/theme", "destination": "/colors", "permanent": false },
    { "source": "/c/:id", "destination": "/:id", "permanent": true },
    { "source": "/s/:id/:story", "destination": "/:id/:story", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
