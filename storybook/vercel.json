{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/showcase", "destination": "/?path=/story/showcase--all-in-one", "permanent": false },
    { "source": "/pusula", "destination": "/?path=/story/pusula--app", "permanent": false },
    { "source": "/gallery", "destination": "/?path=/story/gallery--overview", "permanent": false },
    { "source": "/start", "destination": "/?path=/story/start--overview", "permanent": false },
    { "source": "/theme", "destination": "/?path=/story/colors--overview", "permanent": false },
    { "source": "/palettes", "destination": "/?path=/story/palettes--all", "permanent": false },
    { "source": "/c/:id", "destination": "/?path=/docs/:id--docs", "permanent": false },
    { "source": "/s/:id/:story", "destination": "/?path=/story/:id--:story", "permanent": false }
  ]
}
