{
  "$comment": "Enforcement hook'lari ekosistemden calisir — tek kaynak ~/dev-starter/hooks/ (komutlardaki ~/dev-starter/... mutlak yol kuralinin aynisi; kopyalamak iki kaynak yaratir, biri sessizce bayatlar). Makineye ozgu izinler .claude/settings.local.json'a (gitignore'lu).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dev-starter/hooks/gate-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/dev-starter/hooks/quality-scan.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dev-starter/hooks/routemap-sync.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/dev-starter/hooks/session-brief.sh"
          }
        ]
      }
    ]
  }
}
