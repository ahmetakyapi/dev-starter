# ─── Kod tarafından OKUNAN değişkenler ────────────────────────────────────
# (lib/db.ts → process.env.DATABASE_URL)

# Database (Neon Postgres) — zorunlu
DATABASE_URL=


# ─── Auth: bu şablonda KURULU DEĞİL ───────────────────────────────────────
# next-auth henüz bir bağımlılık değil ve auth.ts / middleware.ts yok.
# Auth eklerken deseni `~/dev-starter/knowledge/patterns.md → Auth` bölümünden
# al; aşağıdakiler ancak o zaman gerekli olur.
#
# AUTH_SECRET=          # openssl rand -base64 32
# AUTH_URL=             # v5'te opsiyonel — Vercel otomatik algılar
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=


# ─── Uygulama meta bilgisi ────────────────────────────────────────────────
# Henüz hiçbir kod bunları okumuyor. Kullanacaksan (örn. layout.tsx
# metadataBase) yorumu kaldır; kullanmayacaksan sil — karşılığı olmayan
# değişken, eksik yapılandırma sanılıp zaman kaybettirir.
#
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=PROJECT_NAME
