# PROJECT_NAME ortam değişkenleri
# Kopyala: cp .env.example .env.local  (.env.local commit'lenmez)
# Boş bırakılan değer TANIMSIZ sayılır (lib/env.ts). Doğrulama derlemenin
# başında çalışır; CI ya da imaj derlemesinde SKIP_ENV_VALIDATION=1 ile atlanır.

# ─── Site ─────────────────────────────────────────────────────────────────
# Kanonik adres (sonda / yok), yalnızca http(s). Site haritası, robots, OG ve
# JSON-LD buradan okur; istemciden de okunur. Vercel'de boşsa üretim alan
# adına düşer. Başka yerde ÜRETİM DERLEMESİNDE ZORUNLU: boşken `npm run build`
# durur (sessizce localhost yayınlamasın). Yerelde derlemek için
# http://localhost:3000 yaz; CI derlemesi SKIP_ENV_VALIDATION=1 ile geçer.
NEXT_PUBLIC_SITE_URL=
# Yalnızca kendi sunucundaki İKİNCİ kopya (staging) için: false → robots
# Disallow + her sayfada noindex. Asıl sitede tanımlama, siteyi dizinden
# çeker. Derlemede okunur; değişince yeniden deploy (guides/11 § 4).
# SITE_INDEXABLE=false

# ─── Veritabanı (Neon Postgres) ───────────────────────────────────────────
# Boşken uygulama açılır; hata yalnızca sorgu atıldığında doğar (lib/db.ts).
# Neon panelindeki "pooled" bağlantı adresi.
DATABASE_URL=

# ─── Kimlik Doğrulama (Auth.js v5) ────────────────────────────────────────
# Üretimde zorunlu. Üret: npx auth secret  ya da  openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth uygulaması. İkisi birlikte tanımlanır ya da ikisi de boş kalır;
# boşken sağlayıcı listeye hiç girmez.
# Geri dönüş adresi: {SITE_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Kendi sunucunda (Vercel dışı) vekil Host başlığını SABİTLEMİYORSA zorunlu:
# Auth.js callback/çerez adreslerini bu kök adresten kurar (auth.ts → trustHost).
# AUTH_URL=https://ornek.com

# ─── Makine Uçları ────────────────────────────────────────────────────────
# Cron ve webhook uçlarının Bearer anahtarı (lib/api-auth.ts). Üretimde boşsa
# korunan uç 503 döner, açık kalmaz.
CRON_SECRET=
