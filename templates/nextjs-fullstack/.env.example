# PROJECT_NAME ortam değişkenleri
# Kopyala: cp .env.example .env.local  (.env.local commit'lenmez)
# Boş bırakılan değer TANIMSIZ sayılır (lib/env.ts). Doğrulama derlemenin
# başında çalışır; CI ya da imaj derlemesinde SKIP_ENV_VALIDATION=1 ile atlanır.

# ─── Site ─────────────────────────────────────────────────────────────────
# Kanonik adres (sonda / yok). Boşsa Vercel üretim alan adına, o da yoksa
# http://localhost:3000 adresine düşer. İstemciden de okunur.
NEXT_PUBLIC_SITE_URL=

# ─── Veritabanı (Neon Postgres) ───────────────────────────────────────────
# Boşken uygulama açılır; hata yalnızca sorgu atıldığında doğar (lib/db.ts).
# Neon panelindeki "pooled" bağlantı adresi.
DATABASE_URL=

# ─── Kimlik Doğrulama (Auth.js v5) ────────────────────────────────────────
# Üretimde zorunlu. Üret: npx auth secret  ya da  openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth uygulaması. İkisi birlikte tanımlanır ya da ikisi de boş kalır;
# boşken sağlayıcı listeye hiç girmez.
# Geri dönüş adresi: {SITE_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── Makine Uçları ────────────────────────────────────────────────────────
# Cron ve webhook uçlarının Bearer anahtarı (lib/api-auth.ts). Üretimde boşsa
# korunan uç 503 döner, açık kalmaz.
CRON_SECRET=
